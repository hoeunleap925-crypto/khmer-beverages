---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

// TODO: change the drinks and prices to your real menu.
// A drink with an `image` shows that photo (from public/) instead of the emoji.
const drinks: {
  icon: string;
  image?: string;
  name: string;
  nameKm: string;
  text: string;
  textKm: string;
  price: string;
}[] = [
  {
    icon: '💧',
    image: '/cambodia-premium-water.jpg',
    name: 'Cambodia Premium Water',
    nameKm: 'ទឹកសុទ្ធ Cambodia Premium Water',
    text: 'Clean drinking water. We sell single bottles and boxes.',
    textKm: 'ទឹកស្អាតសម្រាប់ផឹក។ យើងលក់ជាដប និងជាកេស។',
    price: 'Ask us',
  },
  {
    icon: '🌴',
    name: 'Palm Juice',
    nameKm: 'ទឹកត្នោត',
    text: 'Sweet, fresh juice from Cambodian sugar palm trees.',
    textKm: 'ទឹកត្នោតស្រស់ និងផ្អែម ពីដើមត្នោតខ្មែរ។',
    price: '$1.00',
  },
  {
    icon: '🎋',
    name: 'Sugar Cane Juice',
    nameKm: 'ទឹកអំពៅ',
    text: 'Pressed fresh every day, with a little lime and ice.',
    textKm: 'គាបស្រស់រៀងរាល់ថ្ងៃ ជាមួយក្រូចឆ្មារបន្តិច និងទឹកកក។',
    price: '$0.75',
  },
  {
    icon: '☕',
    name: 'Khmer Iced Coffee',
    nameKm: 'កាហ្វេទឹកដោះគោទឹកកក',
    text: 'Strong Cambodian coffee with sweet condensed milk.',
    textKm: 'កាហ្វេខ្មែរខ្លាំង ជាមួយទឹកដោះគោខាប់ផ្អែម។',
    price: '$1.25',
  },
  {
    icon: '🥥',
    name: 'Fresh Coconut',
    nameKm: 'ដូងស្រស់',
    text: 'Cold young coconut, opened for you.',
    textKm: 'ដូងខ្ចីត្រជាក់ កាប់ឲ្យអ្នកភ្លាមៗ។',
    price: '$1.00',
  },
  {
    icon: '🍵',
    name: 'Lemongrass Ginger Tea',
    nameKm: 'តែស្លឹកគ្រៃ និងខ្ញី',
    text: 'A warm, healthy tea with Khmer herbs. Hot or iced.',
    textKm: 'តែក្តៅល្អសម្រាប់សុខភាព ជាមួយរុក្ខជាតិខ្មែរ។ ក្តៅ ឬទឹកកក។',
    price: '$1.00',
  },
  {
    icon: '🧋',
    name: 'Tamarind Juice',
    nameKm: 'ទឹកអម្ពិល',
    text: 'Sweet and sour, the taste of a Cambodian afternoon.',
    textKm: 'ជូរផ្អែម ជារសជាតិនៃរសៀលនៅកម្ពុជា។',
    price: '$1.00',
  },
];

const reasons = [
  {
    icon: '🌿',
    title: 'Natural',
    titleKm: 'ធម្មជាតិ',
    text: 'Made from real Cambodian fruits and plants. No strange chemicals.',
    textKm: 'ផលិតពីផ្លែឈើ និងរុក្ខជាតិខ្មែរពិតៗ។ គ្មានសារធាតុគីមីចម្លែកៗ។',
  },
  {
    icon: '🧊',
    title: 'Fresh every day',
    titleKm: 'ស្រស់រៀងរាល់ថ្ងៃ',
    text: 'We make our drinks every morning, so they always taste fresh.',
    textKm: 'យើងធ្វើភេសជ្ជៈរៀងរាល់ព្រឹក ដូច្នេះវាតែងតែមានរសជាតិស្រស់។',
  },
  {
    icon: '🤝',
    title: 'Supports local farmers',
    titleKm: 'គាំទ្រកសិករក្នុងស្រុក',
    text: 'We buy from Cambodian farmers and families.',
    textKm: 'យើងទិញពីកសិករ និងគ្រួសារខ្មែរ។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-leaf/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-leaf"></span>
            Traditional drinks from {site.location}
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            The fresh taste of <span class="text-brand">Cambodia</span>.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">រសជាតិស្រស់នៃប្រទេសកម្ពុជា</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            {site.tagline} Palm juice, sugar cane, Khmer iced coffee and more.
            <span class="km" lang="km">ភេសជ្ជៈខ្មែរស្រស់ៗ ធ្វើតាមបែបប្រពៃណី។ ទឹកត្នោត ទឹកអំពៅ កាហ្វេខ្មែរទឹកកក និងច្រើនទៀត។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telegram} class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              Order on Telegram <span lang="km" class="font-khmer font-normal opacity-80">កុម្ម៉ង់</span>
            </a>
            <a href="#drinks" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              See our drinks ↓ <span lang="km" class="font-khmer font-normal opacity-60">មើលភេសជ្ជៈ</span>
            </a>
          </div>
        </div>

        <!-- Illustration: three drink glasses made from simple shapes -->
        <div class="relative flex items-end justify-center gap-4 py-6 sm:gap-6" aria-hidden="true">
          <div class="flex h-48 w-24 flex-col justify-end overflow-hidden rounded-b-3xl rounded-t-lg border-4 border-white bg-white/60 shadow-xl sm:h-60 sm:w-28">
            <div class="h-4/5 bg-gradient-to-t from-brand to-sun"></div>
          </div>
          <div class="flex h-60 w-28 flex-col justify-end overflow-hidden rounded-b-3xl rounded-t-lg border-4 border-white bg-white/60 shadow-2xl sm:h-72 sm:w-32">
            <div class="h-3/4 bg-gradient-to-t from-ink to-brand-dark"></div>
          </div>
          <div class="flex h-44 w-24 flex-col justify-end overflow-hidden rounded-b-3xl rounded-t-lg border-4 border-white bg-white/60 shadow-xl sm:h-52 sm:w-28">
            <div class="h-4/5 bg-gradient-to-t from-leaf to-sun/70"></div>
          </div>
          <span class="absolute top-0 right-6 text-5xl sm:right-16">🌴</span>
        </div>
      </div>
    </section>

    <!-- DRINKS MENU -->
    <section id="drinks" class="scroll-mt-20 border-t border-ink/10 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="font-semibold text-brand">Our drinks <span lang="km" class="font-khmer font-normal">· ភេសជ្ជៈរបស់យើង</span></p>
        <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
          Something for every hot day.
        </h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">មានភេសជ្ជៈសម្រាប់គ្រប់ថ្ងៃក្តៅ។</p>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            drinks.map((d) => (
              <li class="flex flex-col rounded-2xl border border-ink/10 bg-paper p-6">
                {d.image && (
                  <img src={d.image} alt={`${d.name} bottles`} loading="lazy" class="mb-4 aspect-square w-full rounded-xl bg-white object-contain" />
                )}
                <div class="flex items-start justify-between gap-4">
                  <span class="text-4xl">{d.icon}</span>
                  <span class="rounded-full bg-leaf px-3 py-1 text-sm font-bold text-paper">{d.price}</span>
                </div>
                <h3 class="mt-4 font-display text-xl font-bold">
                  {d.name}
                  <span class="km text-base" lang="km">{d.nameKm}</span>
                </h3>
                <p class="mt-2 text-muted">
                  {d.text}
                  <span class="km" lang="km">{d.textKm}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Why choose us <span lang="km" class="font-khmer font-normal">· ហេតុអ្វីជ្រើសរើសយើង</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Real drinks, made with care.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ភេសជ្ជៈពិតៗ ធ្វើដោយយកចិត្តទុកដាក់។</p>
      <ul class="mt-12 grid gap-4 md:grid-cols-3">
        {
          reasons.map((r) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <span class="text-3xl">{r.icon}</span>
              <h3 class="mt-4 font-display text-xl font-bold">
                {r.title}
                <span class="km text-base" lang="km">{r.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {r.text}
                <span class="km" lang="km">{r.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- OUR STORY -->
    <section id="story" class="scroll-mt-20 bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-semibold text-sun">Our story <span lang="km" class="font-khmer font-normal">· រឿងរបស់យើង</span></p>
        <p class="mt-4 font-display text-3xl leading-tight font-bold text-balance sm:text-4xl">
          We grew up drinking <span class="text-sun">fresh palm juice and sugar cane</span> from the market. Now we want to share these Khmer tastes with everyone.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          យើងធំឡើងដោយផឹកទឹកត្នោត និងទឹកអំពៅស្រស់ៗពីផ្សារ។ ឥឡូវនេះ យើងចង់ចែករំលែករសជាតិខ្មែរទាំងនេះជាមួយមនុស្សគ្រប់គ្នា។
        </p>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="scroll-mt-20 px-4 py-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Thirsty? Order today!</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ស្រេកទឹកមែនទេ? កុម្ម៉ង់ថ្ងៃនេះ!</p>
        <p class="mt-6 text-lg">
          Call us at <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="font-bold underline underline-offset-4">{site.phone}</a> or send a message on Telegram.
          <span class="km" lang="km">ទូរស័ព្ទមកយើង ឬផ្ញើសារតាម Telegram។</span>
        </p>
        <a href={site.telegram} class="mt-8 inline-block rounded-full bg-paper px-8 py-4 font-semibold text-ink transition hover:bg-sun">
          Message us on Telegram → <span lang="km" class="font-khmer font-normal">ផ្ញើសារមកយើង</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
